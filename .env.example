# ===================================================================
# Spirit Tech Revolution – Infrastructure partagée
# Variables d'environnement
# ===================================================================
# Copier en .env et remplir TOUTES les valeurs avant de lancer :
#   cp .env.example .env
#   nano .env
#
# ⚠️  .env est dans .gitignore — ne jamais committer ce fichier
# ===================================================================

# ─── Domaine principal ─────────────────────────────────────────────
# Exemple : spirittech.com
# Tous les sous-domaines de l'infra seront auth.INFRA_DOMAIN,
# db.INFRA_DOMAIN, minio.INFRA_DOMAIN, logs.INFRA_DOMAIN, etc.
INFRA_DOMAIN=spirittech.com

# ─── Let's Encrypt (certificats SSL) ──────────────────────────────
ACME_EMAIL=spirittechrevolution@gmail.com

# ─── Traefik dashboard – Basic Auth ───────────────────────────────
# Générer la valeur avec :
#   htpasswd -nb admin MON_MOT_DE_PASSE
# Les $ doivent être doublés dans le fichier .env : $$ au lieu de $
TRAEFIK_BASIC_AUTH=admin:$$apr1$$XXXXXXXX$$YYYYYYYYYYYYYYYYYYYYYYYY

# ─── PostgreSQL partagé ────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Keycloak admin ────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN

# ─── pgAdmin ───────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@spirittech.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# ─── MinIO ─────────────────────────────────────────────────────────
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD_MIN_8_CHARS
